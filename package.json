{
  "name": "markdown-or-chalk",
  "version": "0.2.3",
  "description": "Prints through a single interface as Chalk enhanced CLI output or as Markdown",
  "homepage": "https://github.com/voxpelli/markdown-or-chalk",
  "repository": {
    "type": "git",
    "url": "https://github.com/voxpelli/markdown-or-chalk.git"
  },
  "keywords": [
    "markdown",
    "chalk",
    "terminal",
    "formatting",
    "mdast",
    "cli",
    "ansi"
  ],
  "author": "Pelle Wessman <pelle@kodfabrik.se> (http://kodfabrik.se/)",
  "license": "MIT",
  "engines": {
    "node": "^22.13.0 || >=24"
  },
  "type": "module",
  "exports": "./index.js",
  "types": "index.d.ts",
  "files": [
    "/index.js",
    "/index.d.ts",
    "/index.d.ts.map",
    "lib/**/*.js",
    "lib/**/*.d.ts",
    "lib/**/*.d.ts.map"
  ],
  "scripts": {
    "build": "run-s build:*",
    "build:0": "run-s clean",
    "build:1-declaration": "tsc -p declaration.tsconfig.json",
    "check": "run-s clean && run-p check:*",
    "check:ast-grep": "ast-grep scan",
    "check:installed-check": "installed-check -i @voxpelli/eslint-config -i eslint -i knip -i installed-check -i npm-run-all2",
    "check:knip": "knip",
    "check:lint": "eslint",
    "check:tsc": "tsc",
    "check:type-coverage": "type-coverage --detail --strict --at-least 95 --ignore-files 'test/*'",
    "clean": "run-p clean:*",
    "clean:declarations-lib": "rm -f $(find lib -type f -name '*.d.ts*' ! -name '*-types.d.ts' 2>/dev/null || true)",
    "clean:declarations-top": "rm -f $(find . -maxdepth 1 -type f -name '*.d.ts*' ! -name 'index.d.ts')",
    "fix": "run-s fix:*",
    "fix::ast-grep": "ast-grep scan --update-all",
    "fix:lint": "eslint --fix",
    "prepare": "husky",
    "prepublishOnly": "run-s build",
    "test": "run-s check test:*",
    "test:node": "c8 --reporter=lcov --reporter text --lines 90 --branches 80 --functions 85 node --test 'test/**/*.spec.js'",
    "test-ci": "run-s test:*"
  },
  "dependencies": {
    "@types/mdast": "^4.0.3",
    "boxen": "^8.0.1",
    "chalk": "^5.3.0",
    "cli-highlight": "^2.1.11",
    "is-unicode-supported": "^2.0.0",
    "mdast-util-gfm-table": "^2.0.0",
    "mdast-util-to-markdown": "^2.1.0",
    "mdast-util-to-string": "^4.0.0",
    "strip-ansi": "^7.1.0",
    "terminal-link": "^5.0.0"
  },
  "devDependencies": {
    "@ast-grep/cli": "^0.44.1",
    "@types/node": "^22.20.1",
    "@voxpelli/ast-grep-rules": "^0.1.0",
    "@voxpelli/eslint-config": "^25.1.0",
    "@voxpelli/tsconfig": "^16.2.1",
    "c8": "^12.0.0",
    "eslint": "^10.8.0",
    "husky": "^9.1.7",
    "installed-check": "^10.0.1",
    "knip": "^6.29.0",
    "npm-run-all2": "^9.0.2",
    "type-coverage": "^2.30.1",
    "typescript": "~6.0.3",
    "validate-conventional-commit": "^1.0.4"
  }
}
